# SmartProcure - Environment Variables
# ---------------------------------------------------------
# COPY THIS FILE TO .env AND POPULATE WITH PRODUCTION SECRETS.
# DO NOT COMMIT .env TO VERSION CONTROL.

# 1. DATABASE (AIVEN POSTGRESQL)
# Add ?pgbouncer=true&connection_limit=20 if using connection pooling
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# 2. AUTHENTICATION
# Generate via: openssl rand -base64 32
AUTH_SECRET="your-32-byte-base64-secret"
# Required if deployed behind a proxy / different domain
NEXTAUTH_URL="https://your-production-domain.com"

# 3. PAYMENTS (RAZORPAY)
# Environment: 'sandbox' or 'production'
PAYMENT_ENVIRONMENT="production"
PAYMENT_PROVIDER="razorpay"
RAZORPAY_KEY_ID="rzp_live_your_key_here"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_signature_secret"

# 4. AI / GEMINI ASSISTANT
AI_PROVIDER="gemini"
AI_API_KEY="your_google_gemini_api_key"
AI_MODEL="gemini-2.5-pro"

# 5. EXTERNAL APIS (WEATHER / MAPS)
# Open-Meteo works without a key, but production rate limits might require one
WEATHER_API_KEY=""

# 6. STORAGE (If migrating from local to S3/Cloudflare R2)
# STORAGE_PROVIDER="s3"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION=""
# AWS_BUCKET_NAME=""
